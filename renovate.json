{
    "extends": ["config:recommended"],
    "automerge": true,
    "rangeStrategy": "bump",
    "dependencyDashboard": true,
    "pinDigests": true,
    "branchPrefix": "deps/",
    "minimumReleaseAge": "7 days",
    "internalChecksFilter": "strict",
    "enabledManagers": ["github-actions", "custom.regex"],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Major versions of the actions in the workflow snippets that embed.php prints.",
            "managerFilePatterns": ["/^embed\\.php$/"],
            "matchStrings": ["uses: (?<depName>[\\w.-]+/[\\w.-]+)@v(?<currentValue>\\d+) "],
            "datasourceTemplate": "github-tags",
            "extractVersionTemplate": "^v(?<version>\\d+)(\\.\\d+)*$",
            "versioningTemplate": "loose"
        },
        {
            "customType": "regex",
            "description": "Docker images that workflows run with 'docker run'.",
            "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
            "matchStrings": ["docker run .*? (?<depName>[\\w.-]+/[\\w.-]+):(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[a-f0-9]{64})"],
            "datasourceTemplate": "docker"
        }
    ],
    "packageRules": [
        {
            "matchPackageNames": ["*"],
            "groupName": "all dependencies",
            "groupSlug": "all"
        },
        {
            "matchManagers": ["custom.regex"],
            "pinDigests": false,
            "rangeStrategy": "replace"
        }
    ]
}
