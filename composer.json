{
    "name": "alexskrypnyk/prompty",
    "description": "Zero-dependency interactive CLI prompt library",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Alex Skrypnyk",
            "email": "prompty@alexskrypnyk.com",
            "homepage": "https://alexskrypnyk.com",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://github.com/alexskrypnyk/prompty",
    "support": {
        "issues": "https://github.com/alexskrypnyk/prompty/issues",
        "source": "https://github.com/alexskrypnyk/prompty"
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "alexskrypnyk/phpunit-helpers": "^0.16.0",
        "bamarni/composer-bin-plugin": "^1.9.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2.1",
        "drevops/phpcs-standard": "^0.7",
        "drupal/coder": "^9.0.1",
        "ergebnis/composer-normalize": "^2.52.0",
        "opis/closure": "^4.5.0",
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^11.5.56",
        "rector/rector": "^2.6.2"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "classmap": [
            "Prompty.php",
            "PromptyTestTrait.php"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/phpunit"
        ]
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true
        },
        "discard-changes": true,
        "policy": {
            "advisories": {
                "block": false,
                "audit": "fail"
            },
            "abandoned": {
                "audit": "report"
            }
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": [
            "phpcs",
            "phpstan",
            "rector --dry-run",
            "php .util/check-embed.php"
        ],
        "lint-fix": [
            "rector",
            "phpcbf"
        ],
        "reset": "rm -Rf vendor vendor-bin composer.lock",
        "test": "phpunit --no-coverage",
        "test-coverage": "phpunit"
    }
}
